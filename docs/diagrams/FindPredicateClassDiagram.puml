@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR_T4
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
' style.puml hides all members; show the ones defined below
show members
hide empty members

package Logic as LogicPackage <<Rectangle>> {
Class FindCommandParser LOGIC_COLOR
Class FindCommand LOGIC_COLOR
}

package Model as ModelPackage <<Rectangle>> {
Class "<<interface>>\nPredicate" as Predicate MODEL_COLOR
Class MatchesAllCriteriaPredicate MODEL_COLOR
Class "{abstract}\nFieldContainsKeywordsPredicate" as FieldPredicate MODEL_COLOR {
  - keywords : List<String>
  # matches(Person, String) : boolean
}
Class NameContainsKeywordsPredicate MODEL_COLOR
Class PhoneContainsKeywordsPredicate MODEL_COLOR
Class AddressContainsKeywordsPredicate MODEL_COLOR
Class TagContainsKeywordsPredicate MODEL_COLOR
Class NoteContainsKeywordsPredicate MODEL_COLOR
Class VisitDateOnDaysPredicate MODEL_COLOR {
  - days : List<LocalDate>
}
}

FindCommandParser .right.> FindCommand : <<create>>
FindCommandParser ..> MatchesAllCriteriaPredicate : <<create>>
FindCommand --> "1" Predicate : predicate

MatchesAllCriteriaPredicate .up.|> Predicate
MatchesAllCriteriaPredicate --> "1..*" Predicate : criteria
FieldPredicate .up.|> Predicate
VisitDateOnDaysPredicate .up.|> Predicate

' Two rows of subclasses keep the diagram narrow enough to read in the DG
NameContainsKeywordsPredicate -up-|> FieldPredicate
PhoneContainsKeywordsPredicate -up-|> FieldPredicate
AddressContainsKeywordsPredicate -up-|> FieldPredicate
TagContainsKeywordsPredicate -up--|> FieldPredicate
NoteContainsKeywordsPredicate -up--|> FieldPredicate
@enduml
