@startuml
!include style.puml
skinparam ArrowFontStyle plain

skinparam ParticipantPadding 6
skinparam Participant {
  FontSize 15
  Padding 8
}
skinparam Sequence {
  ArrowFontSize 14
  ParticipantFontSize 15
}
skinparam Note {
  FontSize 14
}

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":NextCommandParser" as NextCommandParser LOGIC_COLOR
participant "n:NextCommand" as NextCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute(commandText)
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(commandText)
activate AddressBookParser

AddressBookParser -> NextCommandParser : parse(arguments)
activate NextCommandParser

create NextCommand
NextCommandParser -> NextCommand : NextCommand(...)
activate NextCommand

NextCommand --> NextCommandParser
deactivate NextCommand

NextCommandParser --> AddressBookParser : n
deactivate NextCommandParser

AddressBookParser --> LogicManager : n
deactivate AddressBookParser

LogicManager -> NextCommand : execute(m)
activate NextCommand

NextCommand -> Model : getFilteredPersonList()
activate Model
Model --> NextCommand : displayedPersons
deactivate Model

NextCommand -> NextCommand : createUpdatedPerson(...)
activate NextCommand
note right of NextCommand
  Replacement patient:
  Append original current datetime
  to visit history.
  Set requested datetime as current.
  Preserve all other patient fields.
end note
NextCommand --> NextCommand : updatedPerson
deactivate NextCommand

NextCommand -> Model : setPerson(...)
activate Model
Model --> NextCommand
deactivate Model

NextCommand -> Model : updateFilteredPersonList(...)
activate Model
Model --> NextCommand
deactivate Model

NextCommand --> LogicManager : result
deactivate NextCommand

LogicManager -> LogicManager : saveAddressBook()
activate LogicManager
deactivate LogicManager

[<--LogicManager : result
deactivate LogicManager
@enduml
