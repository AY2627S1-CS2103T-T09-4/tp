@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":NextCommandParser" as NextCommandParser LOGIC_COLOR
participant "n:NextCommand" as NextCommand LOGIC_COLOR
participant ":CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("next 1 31/12/2026 0930")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("next 1 31/12/2026 0930")
activate AddressBookParser

AddressBookParser -> NextCommandParser : parse(" 1 31/12/2026 0930")
activate NextCommandParser

create NextCommand
NextCommandParser -> NextCommand : NextCommand(...)
activate NextCommand

NextCommand --> NextCommandParser
deactivate NextCommand

NextCommandParser --> AddressBookParser : n
deactivate NextCommandParser

AddressBookParser --> LogicManager : n
deactivate AddressBookParser

LogicManager -> NextCommand : execute(m)
activate NextCommand

NextCommand -> Model : getFilteredPersonList()
activate Model
Model --> NextCommand : displayedPersons
deactivate Model

NextCommand -> NextCommand : createUpdatedPerson(personToUpdate)
activate NextCommand
NextCommand --> NextCommand : updatedPerson
deactivate NextCommand

note right of NextCommand
  Successful main flow only.
  Validation, conflict, and confirmation paths omitted.
end note

NextCommand -> Model : setPerson(personToUpdate, updatedPerson)
activate Model
Model --> NextCommand
deactivate Model

NextCommand -> Model : updateFilteredPersonList(show all)
activate Model
Model --> NextCommand
deactivate Model

create CommandResult
NextCommand -> CommandResult : CommandResult(successMessage)
activate CommandResult
CommandResult --> NextCommand
deactivate CommandResult

NextCommand --> LogicManager : result
deactivate NextCommand

LogicManager -> Model : getAddressBook()
activate Model
Model --> LogicManager : addressBook
deactivate Model

LogicManager -> Storage : saveAddressBook(addressBook)
activate Storage
Storage --> LogicManager
deactivate Storage

[<--LogicManager : result
deactivate LogicManager
@enduml
