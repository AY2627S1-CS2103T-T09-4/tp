<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.stage.Stage?>

<fx:root height="500.0" minHeight="280.0" minWidth="460.0" resizable="true" title="Help"
         type="javafx.stage.Stage" width="640.0" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <BorderPane fx:id="helpMessageContainer">
        <center>
          <ScrollPane fx:id="helpScrollPane" fitToWidth="true" focusTraversable="true" hbarPolicy="NEVER" pannable="true"
                      vbarPolicy="AS_NEEDED">
            <content>
              <VBox alignment="TOP_LEFT" fillWidth="true" spacing="8.0">
                <children>
                  <Label styleClass="helpTitle" text="Available commands" />
                  <FlowPane fx:id="keyboardHint" alignment="CENTER_LEFT" focusTraversable="false" hgap="4.0"
                            prefWrapLength="500.0" styleClass="helpNavigationHint" vgap="4.0">
                    <children>
                      <Label mouseTransparent="true" styleClass="helpKeyCap" text="↑" />
                      <Label mouseTransparent="true" styleClass="helpKeyCap" text="↓" />
                      <Label styleClass="helpNavigationHintText" text="Scroll ·" />
                      <Label mouseTransparent="true" styleClass="helpKeyCap" text="Tab" />
                      <Label styleClass="helpKeySeparator" text="/" />
                      <Label mouseTransparent="true" styleClass="helpKeyCap" text="Shift" />
                      <Label styleClass="helpKeySeparator" text="+" />
                      <Label mouseTransparent="true" styleClass="helpKeyCap" text="Tab" />
                      <Label styleClass="helpNavigationHintText" text="Move focus ·" />
                      <Label mouseTransparent="true" styleClass="helpKeyCap" text="Esc" />
                      <Label styleClass="helpNavigationHintText" text="Close" />
                    </children>
                  </FlowPane>
                  <TextFlow fx:id="notationLegend" styleClass="helpNotationLegend">
                    <children>
                      <Text styleClass="helpNotationToken" text="UPPERCASE" />
                      <Text styleClass="helpNotationLegendText" text=": replace with your values · " />
                      <Text styleClass="helpNotationToken" text="[ ]" />
                      <Text styleClass="helpNotationLegendText" text=": optional · " />
                      <Text styleClass="helpNotationToken" text="..." />
                      <Text styleClass="helpNotationLegendText" text=": repeatable" />
                    </children>
                  </TextFlow>
                  <VBox fx:id="patientAndVisitCommands" fillWidth="true" spacing="6.0">
                    <children>
                      <Label styleClass="helpSectionTitle" text="Manage patients and visits" />
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="add" />
                              <Text styleClass="helpCommandDescriptionText" text=" — Add a patient." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="add n/NAME p/PHONE a/ADDRESS vd/DATETIME"
                                 wrapText="true" />
                          <FlowPane alignment="TOP_LEFT" hgap="8.0" styleClass="helpCommandContinuation" vgap="2.0">
                            <children>
                              <Label styleClass="helpCommandToken" text="[e/EMAIL]" />
                              <Label styleClass="helpCommandToken" text="[ec/[NAME, ]PHONE_NUMBER]" />
                              <Label styleClass="helpCommandToken" text="[dob/DATE]" />
                              <Label styleClass="helpCommandToken" text="[bt/BLOOD_TYPE]" />
                              <Label styleClass="helpCommandToken" text="[all/ALLERGIES]" />
                              <Label styleClass="helpCommandToken" text="[alc/ALCOHOL_HISTORY]" />
                              <Label styleClass="helpCommandToken" text="[smk/STATUS]" />
                              <Label styleClass="helpCommandToken" text="[note/NOTES]" />
                              <Label styleClass="helpCommandToken" text="[t/TAG]..." />
                            </children>
                          </FlowPane>
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="edit" />
                              <Text styleClass="helpCommandDescriptionText"
                                    text=" — Update a patient's details. Provide at least one field." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="edit INDEX" wrapText="true" />
                          <FlowPane alignment="TOP_LEFT" hgap="8.0" styleClass="helpCommandContinuation" vgap="2.0">
                            <children>
                              <Label styleClass="helpCommandToken" text="[n/NAME]" />
                              <Label styleClass="helpCommandToken" text="[p/PHONE]" />
                              <Label styleClass="helpCommandToken" text="[a/ADDRESS]" />
                              <Label styleClass="helpCommandToken" text="[vd/DATETIME]" />
                              <Label styleClass="helpCommandToken" text="[e/EMAIL]" />
                              <Label styleClass="helpCommandToken" text="[ec/[NAME, ]PHONE_NUMBER]" />
                              <Label styleClass="helpCommandToken" text="[dob/DATE]" />
                              <Label styleClass="helpCommandToken" text="[bt/BLOOD_TYPE]" />
                              <Label styleClass="helpCommandToken" text="[all/ALLERGIES]" />
                              <Label styleClass="helpCommandToken" text="[alc/ALCOHOL_HISTORY]" />
                              <Label styleClass="helpCommandToken" text="[smk/STATUS]" />
                              <Label styleClass="helpCommandToken" text="[note/NOTES]" />
                              <Label styleClass="helpCommandToken" text="[t/TAG]..." />
                            </children>
                          </FlowPane>
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="next" />
                              <Text styleClass="helpCommandDescriptionText"
                                    text=" — Schedule a patient's next visit." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="next INDEX DATETIME" wrapText="true" />
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="prev" />
                              <Text styleClass="helpCommandDescriptionText"
                                    text=" — Restore the latest previous visit date." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="prev INDEX" wrapText="true" />
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="delete" />
                              <Text styleClass="helpCommandDescriptionText" text=" — Delete a patient." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="delete INDEX" wrapText="true" />
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="clear" />
                              <Text styleClass="helpCommandDescriptionText" text=" — Remove all patients." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="clear" wrapText="true" />
                        </children>
                      </VBox>
                    </children>
                  </VBox>
                  <VBox fx:id="findingAndViewingCommands" fillWidth="true" spacing="6.0">
                    <children>
                      <Label styleClass="helpSectionTitle" text="Find and view patients" />
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="list" />
                              <Text styleClass="helpCommandDescriptionText" text=" — Show all patients." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="list" wrapText="true" />
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="find" />
                              <Text styleClass="helpCommandDescriptionText"
                                    text=" — Find patients. Provide at least one field." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="find" wrapText="true" />
                          <FlowPane alignment="TOP_LEFT" hgap="8.0" styleClass="helpCommandContinuation" vgap="2.0">
                            <children>
                              <Label styleClass="helpCommandToken" text="[n/NAME_KEYWORD...]" />
                              <Label styleClass="helpCommandToken" text="[p/PHONE_KEYWORD...]" />
                              <Label styleClass="helpCommandToken" text="[a/ADDRESS_KEYWORD...]" />
                              <Label styleClass="helpCommandToken" text="[t/TAG_KEYWORD...]" />
                              <Label styleClass="helpCommandToken" text="[vd/DATE...]" />
                              <Label styleClass="helpCommandToken" text="[note/NOTE_KEYWORD...]" />
                            </children>
                          </FlowPane>
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="view" />
                              <Text styleClass="helpCommandDescriptionText"
                                    text=" — Show a patient's details." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="view INDEX" wrapText="true" />
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="sort" />
                              <Text styleClass="helpCommandDescriptionText"
                                    text=" — Sort displayed patients by visit date." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="sort date [START_DATE]" wrapText="true" />
                        </children>
                      </VBox>
                    </children>
                  </VBox>
                  <VBox fx:id="applicationCommands" fillWidth="true" spacing="2.0">
                    <children>
                      <Label styleClass="helpSectionTitle" text="Application controls" />
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="help" />
                              <Text styleClass="helpCommandDescriptionText" text=" — Open this help window." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="help" wrapText="true" />
                        </children>
                      </VBox>
                      <VBox styleClass="helpCommand" fillWidth="true" spacing="2.0">
                        <children>
                          <TextFlow styleClass="helpCommandDescription">
                            <children>
                              <Text styleClass="helpCommandName" text="exit" />
                              <Text styleClass="helpCommandDescriptionText" text=" — Close Doc." />
                            </children>
                          </TextFlow>
                          <Label styleClass="helpCommandSyntax" text="exit" wrapText="true" />
                        </children>
                      </VBox>
                    </children>
                  </VBox>
                </children>
                <padding>
                  <Insets bottom="8.0" left="16.0" right="16.0" top="12.0" />
                </padding>
              </VBox>
            </content>
          </ScrollPane>
        </center>
        <bottom>
          <VBox alignment="TOP_LEFT" fillWidth="true" spacing="4.0">
            <children>
              <Label fx:id="helpMessage" styleClass="helpMessage" text="Label" wrapText="true" />
              <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                  <Button fx:id="openGuideButton" mnemonicParsing="false" onAction="#openUserGuide"
                          text="Open User Guide" />
                  <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
                  <Button fx:id="closeButton" cancelButton="true" mnemonicParsing="false"
                          onAction="#closeWindow" text="Close" />
                </children>
              </HBox>
              <Label fx:id="guideStatus" managed="false" styleClass="helpHint" visible="false" wrapText="true" />
            </children>
            <padding>
              <Insets bottom="8.0" left="16.0" right="16.0" top="6.0" />
            </padding>
          </VBox>
        </bottom>
      </BorderPane>
    </Scene>
  </scene>
</fx:root>
