<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root resizable="false" title="Help" type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>
      <VBox fx:id="helpMessageContainer" prefWidth="620.0" spacing="12.0">
        <padding>
          <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
        </padding>
        <Label fx:id="helpMessage" wrapText="true" />
        <Hyperlink fx:id="userGuideLink" onAction="#openUserGuide" wrapText="true"
                   minWidth="0.0" maxWidth="Infinity" />
        <HBox alignment="CENTER_LEFT" spacing="16.0">
          <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
          <Label fx:id="closeHint" text="Press Esc to close" />
        </HBox>
        <Label fx:id="internetHint" text="Viewing the online guide requires Internet access." wrapText="true" />
        <Label fx:id="browserError" visible="false" managed="false" wrapText="true" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
