<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root height="420.0" minHeight="280.0" minWidth="460.0" resizable="true" title="Help"
         type="javafx.stage.Stage" width="640.0" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <ScrollPane fx:id="helpScrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true"
                  vbarPolicy="AS_NEEDED">
        <content>
          <VBox alignment="TOP_LEFT" fillWidth="true" fx:id="helpMessageContainer" spacing="16.0">
            <children>
              <Label styleClass="helpTitle" text="User Guide" />
              <Label fx:id="helpMessage" styleClass="helpMessage" text="Label" wrapText="true" />
              <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                  <Button fx:id="openGuideButton" mnemonicParsing="false" onAction="#openUserGuide"
                          text="Open User Guide" />
                  <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
                  <Button fx:id="closeButton" cancelButton="true" mnemonicParsing="false"
                          onAction="#closeWindow" text="Close" />
                </children>
              </HBox>
              <Label fx:id="guideStatus" managed="false" styleClass="helpHint" visible="false" wrapText="true" />
              <Label styleClass="helpHint" text="Press Escape to close this window." wrapText="true" />
            </children>
            <padding>
              <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
          </VBox>
        </content>
      </ScrollPane>
    </Scene>
  </scene>
</fx:root>
