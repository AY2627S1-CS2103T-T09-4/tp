<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="pane-with-border"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <content>
    <VBox fx:id="detailsContainer" fillWidth="true" managed="false" spacing="10" visible="false">
      <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
      </padding>
      <Label id="name" fx:id="name" maxWidth="Infinity" styleClass="label-bright" wrapText="true" />
      <Label id="phone" fx:id="phone" maxWidth="Infinity" styleClass="label-bright" wrapText="true" />
      <Label id="emergencyContact" fx:id="emergencyContact" maxWidth="Infinity"
             styleClass="label-bright" wrapText="true" />
      <Label id="email" fx:id="email" maxWidth="Infinity" styleClass="label-bright" wrapText="true" />
      <Label id="address" fx:id="address" maxWidth="Infinity" styleClass="label-bright" wrapText="true" />
      <Label id="visitDate" fx:id="visitDate" maxWidth="Infinity" styleClass="label-bright" wrapText="true" />
      <Label id="previousVisitDatesHeader" text="Previous visit dates:" maxWidth="Infinity"
             styleClass="label-bright" wrapText="true" />
      <Label id="previousVisitDates" fx:id="previousVisitDates" maxWidth="Infinity" minHeight="-Infinity"
             styleClass="label-bright" wrapText="true" />
      <Label id="note" fx:id="note" maxWidth="Infinity" styleClass="label-bright" wrapText="true" />
      <Label id="tags" fx:id="tags" maxWidth="Infinity" styleClass="label-bright" wrapText="true" />
    </VBox>
  </content>
</ScrollPane>
